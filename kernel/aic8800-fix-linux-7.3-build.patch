+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+/*
+ * 7.3: probe_client became probe_peer and cfg80211 now allocates the cookie.
+ * The driver still reports its own probe id; hostapd-style AP use is not our
+ * target on the P25T (station only).
+ */
+static int rwnx_cfg80211_probe_peer(struct wiphy *wiphy, struct net_device *dev,
+			const u8 *peer, u64 cookie)
+{
+	u64 own_cookie;
+	return rwnx_cfg80211_probe_client(wiphy, dev, peer, &own_cookie);
+}
+#endif
