From de42a11a4fed770dfdb26cfc2c13d9b7a5b6f3c5 Mon Sep 17 00:00:00 2001
From: "Jose M. Caballero Guerrero"
 <80172778+Caballero-git@users.noreply.github.com>
Date: Fri, 25 Sep 2026 14:49:11 +0200
Subject: [PATCH 04/30] arm64: dts: rockchip: P25T: add the stock DWC3 quirks
 to the OTG controller

Without snps,dis-u2-freeclk-exists-quirk and friends, binding the USB
gadget while the USB2 PHY is suspended fails with 'failed to enable
ep0out' and the host sees -71 enumeration errors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0156c5MfQpFxaYWNNLMrcym9
---
 arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts b/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts
index 03f948b8d..e61a84c7a 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts
@@ -132,6 +132,17 @@ &usb_host0_xhci {
 	maximum-speed = "high-speed";
 	phys = <&usb2phy0_otg>;
 	phy-names = "usb2-phy";
+	/*
+	 * Same DWC3 quirks as the stock Android device tree. Without
+	 * dis-u2-freeclk-exists the controller expects a free-running UTMI
+	 * clock while the USB2 PHY is suspended (no cable); it has none, so
+	 * enabling ep0 times out ("failed to enable ep0out") and the PC then
+	 * gets no answer (-71).
+	 */
+	snps,dis_enblslpm_quirk;
+	snps,dis-u2-freeclk-exists-quirk;
+	snps,dis-del-phy-power-chg-quirk;
+	snps,dis-tx-ipgap-linecheck-quirk;
 	status = "okay";
 };
 
