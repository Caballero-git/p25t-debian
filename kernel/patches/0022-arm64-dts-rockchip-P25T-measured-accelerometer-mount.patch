From d5955dbb9ad2dbbb90d258931e9bec3e5cbafa3e Mon Sep 17 00:00:00 2001
From: "Jose M. Caballero Guerrero"
 <80172778+Caballero-git@users.noreply.github.com>
Date: Sat, 3 Oct 2026 11:03:37 +0200
Subject: [PATCH 22/30] arm64: dts: rockchip: P25T: measured accelerometer
 mount-matrix

The SC7A20 mount-matrix was translated from the stock Android driver
flags (swap_xy, revert_y) and never checked. A tilt test with four
poses (tests/test_19.sh: flat screen up, landscape upright, landscape
upside down, portrait) shows it wrong in all four.

Measured: out of the screen = +raw y, landscape top = -raw z,
landscape left = +raw x. Use the matrix for the tablet's natural
landscape frame (panel rotation = 90): x right, y up, z out of the
screen. Its determinant is -1: the SC7A20 reports a left-handed frame,
as on the PineTab2 (rk3566-pinetab2.dtsi, same chip). Tried on the
tablet first by editing the DTB with fdtput; all four poses correct.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/rockchip/rk3566-teclast-p25t.dts | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts b/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts
index b6b603ead..c3b3e3504 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t.dts
@@ -767,9 +767,8 @@ touchscreen@40 {
 	 * which with these flags gives out = (rawY, -rawX, rawZ), i.e. the
 	 * matrix below. NOT verified against the real Android driver source
 	 * (proprietary, unavailable) - only against the four flag values
-	 * themselves. Treat screen-rotation/orientation behaviour as
-	 * unconfirmed until checked against real tilt tests; see
-	 * hardware.org/todo.org.
+	 * themselves. It turned out wrong; the matrix in the node is the
+	 * measured one (patch 0026).
 	 */
 	accelerometer@19 {
 		compatible = "silan,sc7a20";
@@ -780,9 +779,17 @@ accelerometer@19 {
 		 * IRQ the pin fired 100000 times at boot ("irq 61: nobody
 		 * cared", tests/result_11_speaker2.txt). Polled sysfs reads work.
 		 */
-		mount-matrix = "0", "1", "0",
-				"-1", "0", "0",
-				"0", "0", "1";
+		/*
+		 * Measured 2026-10-03 (tests/test_19.sh, 4 poses; the stock-flag
+		 * translation above was wrong in all four): screen-out = +raw y,
+		 * landscape top = -raw z, landscape left = +raw x. Matrix for the
+		 * natural (landscape, rotation = 90) frame: x right, y up, z out
+		 * of the screen. Determinant -1: the SC7A20 reports a left-handed
+		 * frame, as on the PineTab2 (rk3566-pinetab2.dtsi, same chip).
+		 */
+		mount-matrix = "-1", "0", "0",
+				"0", "0", "-1",
+				"0", "1", "0";
 	};
 };
 
