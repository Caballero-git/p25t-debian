+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/galaxycore,gc02m2.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GalaxyCore GC02M2 2 MP MIPI CSI-2 sensor
+
+maintainers:
+  - Jose M. Caballero Guerrero <80172778+Caballero-git@users.noreply.github.com>
+
+description:
+  The GC02M2 is a 1600x1200 raw Bayer image sensor with a 1-lane MIPI
+  CSI-2 data interface and a CCI (I2C compatible) control bus.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: galaxycore,gc02m2
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  dovdd-supply: true
+
+  avdd-supply: true
+
+  dvdd-supply: true
+
+  reset-gpios:
+    description: GPIO connected to the RESET pin (active high).
+    maxItems: 1
+
+  powerdown-gpios:
+    description: GPIO connected to the PWDN pin (active low).
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    description:
+      Output port node, single endpoint describing the CSI-2 transmitter.
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera-sensor@10 {
+            compatible = "galaxycore,gc02m2";
+            reg = <0x10>;
+            clocks = <&cif_clk_out>;
+            reset-gpios = <&gpio4 8 GPIO_ACTIVE_HIGH>;
+            powerdown-gpios = <&gpio4 11 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&vcc2v8_dvp>;
+            dovdd-supply = <&vcc1v8_dvp>;
+            dvdd-supply = <&vcc_camera>;
+            orientation = <0>;
+
+            port {
+                endpoint {
+                    data-lanes = <1>;
+                    link-frequencies = /bits/ 64 <336000000>;
+                    remote-endpoint = <&csi_input>;
+                };
+            };
+        };
+    };
+...
