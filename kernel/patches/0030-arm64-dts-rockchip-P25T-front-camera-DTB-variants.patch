diff --git a/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t-front-camera.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t-front-camera.dtsi
new file mode 100644
index 000000000..50bf18199
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t-front-camera.dtsi
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * P25T, front camera instead of the rear one: included by the
+ * rk3566-teclast-p25t-front.dts (USB-C device mode) and
+ * rk3566-teclast-p25t-front-usbhost.dts (USB-C host mode) variants, after
+ * their base DT. Use one of them in place of rk3566-teclast-p25t.dtb. The
+ * SoC has one CSI-2 host, so one camera at a time: here the rear GC5035
+ * is left out and the front GalaxyCore GC02M2 (2 MP, 1 MIPI lane) feeds
+ * the CSI-2 host -> VICAP -> /dev/videoN instead.
+ *
+ * From the stock Android DT: gc02m2 on i2c2 at 0x10, reset GPIO4_B0
+ * (active high), pwdn GPIO4_B3 (active low), same MCLK (CLK_CIF_OUT on
+ * GPIO4_C0), power domain and supplies as the rear camera, data on the
+ * D-PHY's second half (lanes 2-3, split mode, "csi2-dphy2").
+ */
+
+&csi_dphy {
+	/* D-PHY lanes 2-3 + clock lane 1 -> CSI-2 host */
+	rockchip,split-lanes-2-3;
+};
+
+&csi_input {
+	data-lanes = <1>;
+	remote-endpoint = <&gc02m2_output>;
+};
+
+&gc5035 {
+	status = "disabled";
+	/delete-node/ port;
+};
+
+&i2c2 {
+	gc02m2: camera-sensor@10 {
+		compatible = "galaxycore,gc02m2";
+		reg = <0x10>;
+		clocks = <&cru CLK_CIF_OUT>;
+		assigned-clocks = <&cru CLK_CIF_OUT>;
+		assigned-clock-rates = <24000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cif_clk &gc02m2_ctrl>;
+		power-domains = <&power RK3568_PD_VI>;
+		reset-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+		powerdown-gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
+		avdd-supply = <&vcc2v8_dvp>;
+		dovdd-supply = <&vcc1v8_dvp>;
+		dvdd-supply = <&vcc_camera>;
+		orientation = <0>; /* front */
+		/* mounted upside down: both flips give the upright picture */
+		rotation = <180>;
+
+		port {
+			gc02m2_output: endpoint {
+				data-lanes = <1>;
+				link-frequencies = /bits/ 64 <336000000>;
+				remote-endpoint = <&csi_input>;
+			};
+		};
+	};
+};
+
+&pinctrl {
+	camera {
+		gc02m2_ctrl: gc02m2-ctrl {
+			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,
+					<4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t-front-usbhost.dts b/arch/arm64/boot/dts/rockchip/rk3566-teclast-p25t-front-usbhost.dts
