From b9dadeffbad94525dd964e06e7fc6f863779821a Mon Sep 17 00:00:00 2001
From: "Jose M. Caballero Guerrero"
 <80172778+Caballero-git@users.noreply.github.com>
Date: Wed, 21 Oct 2026 09:23:37 +0200
Subject: [PATCH 28/30] phy: rockchip: inno-csidphy: rk3568 split mode for
 lanes 2-3

The rk3568 CSI D-PHY can run as two halves (split mode): data lanes 0-1
with clock lane 0 and data lanes 2-3 with clock lane 1, each half routed
by GRF VI_CON1 to the CSI-2 host ("CIF" path) or to the ISP. Mainline
only knew the full mode. On the Teclast P25T the front camera (GC02M2,
1 lane) is wired to lanes 2-3, so the CSI-2 host needs the second half.

Add a boolean DT property rockchip,split-lanes-2-3. When set (rk3568
only), power-on follows Rockchip's BSP driver (phy-rockchip-csi2-dphy-hw.c,
dphy2): digital reset with the dual-mode bit (0x80 = 0x5e, 0x5f), lane 2-3
and clock enable in CTRL_LANE_ENABLE bits 4-5 and 6, GRF VI_CON0
DATALANE_EN1 (bits 7:6) and CLKLANE1_EN (bit 10), GRF VI_CON1 split
(bit 7) with lanes 2-3 to the CSI-2 host (bit 11) and lanes 0-1 to the
ISP (bit 12 = 0), THS settle on clock lane 1 (0x3e0) and lanes 2-3
(0x2e0, 0x360), clock phase in 0xcc.

The first half's GRF enables, clock lane 0 (VI_CON0 bit 8) and data
lanes 0-1 (bits 5:4), are set as well. Without them the front camera
streamed but the VICAP behind the CSI-2 host wrote past its buffers (an
IOMMU write page fault, then 200000 unhandled interrupts and the VICAP
interrupt switched off, or a frozen tablet); with them, as the full mode
leaves them, frames are clean. The D-PHY's own lane 0-1 enables stay off.

Full mode now also writes VI_CON1 bits 7 and 11 back to their reset
value 0. The GRF register tables get the full enum size, so variants that
do not describe a field (rk3368 lists only FORCERXMODE) read valid = 0
there.

P25T tests: p25t-sway tests/ 08 (by hand) and 11-13.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0156c5MfQpFxaYWNNLMrcym9
---
 .../bindings/phy/rockchip-inno-csi-dphy.yaml  |   8 ++
 .../phy/rockchip/phy-rockchip-inno-csidphy.c  | 118 +++++++++++++++++-
 2 files changed, 121 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/phy/rockchip-inno-csi-dphy.yaml b/Documentation/devicetree/bindings/phy/rockchip-inno-csi-dphy.yaml
index 913aa688c..a34e4f5f7 100644
--- a/Documentation/devicetree/bindings/phy/rockchip-inno-csi-dphy.yaml
+++ b/Documentation/devicetree/bindings/phy/rockchip-inno-csi-dphy.yaml
@@ -66,6 +66,14 @@ properties:
       corresponds to an approximately 40 ps delay as described in the hardware
       specification.
 
+  rockchip,split-lanes-2-3:
+    type: boolean
+    description:
+      rk3568 only. Run the D-PHY in split mode and connect its second half
+      (data lanes 2-3 with clock lane 1) to the CSI-2 host, for a sensor
+      wired to those pins. Without it the CSI-2 host uses data lanes 0-3
+      in full mode.
+
 required:
   - compatible
   - reg
diff --git a/drivers/phy/rockchip/phy-rockchip-inno-csidphy.c b/drivers/phy/rockchip/phy-rockchip-inno-csidphy.c
index d989f1649..6e785a04a 100644
--- a/drivers/phy/rockchip/phy-rockchip-inno-csidphy.c
+++ b/drivers/phy/rockchip/phy-rockchip-inno-csidphy.c
@@ -36,6 +36,7 @@
 #define CSIDPHY_CTRL_LANE_ENABLE		0x00
 #define CSIDPHY_CTRL_LANE_ENABLE_CK		BIT(6)
 #define CSIDPHY_CTRL_LANE_ENABLE_MASK		GENMASK(5, 2)
+#define CSIDPHY_CTRL_LANE_ENABLE_SPLIT_MASK	GENMASK(5, 4)
 #define CSIDPHY_CTRL_LANE_ENABLE_UNDEFINED	BIT(0)
 
 /* not present on all variants */
@@ -48,15 +49,19 @@
 #define CSIDPHY_CTRL_DIG_RST			0x80
 #define CSIDPHY_CTRL_DIG_RST_UNDEFINED		0x1e
 #define CSIDPHY_CTRL_DIG_RST_RESET		BIT(0)
+#define CSIDPHY_CTRL_DIG_RST_DUAL_MODE		BIT(6)
 
 /* offset after ths_settle_offset */
 #define CSIDPHY_CLK_THS_SETTLE			0
 #define CSIDPHY_LANE_THS_SETTLE(n)		(((n) + 1) * 0x80)
+/* split mode: second clock lane, after data lane 3 */
+#define CSIDPHY_CLK1_THS_SETTLE			CSIDPHY_LANE_THS_SETTLE(4)
 #define CSIDPHY_THS_SETTLE_MASK			GENMASK(6, 0)
 
 /* offset after calib_offset */
 #define CSIDPHY_CLK_CALIB_EN			0
 #define CSIDPHY_LANE_CALIB_EN(n)		(((n) + 1) * 0x80)
+#define CSIDPHY_CLK1_CALIB_EN			CSIDPHY_LANE_CALIB_EN(4)
 #define CSIDPHY_CALIB_EN			BIT(7)
 
 /* Configure the count time of the THS-SETTLE by protocol. */
@@ -70,6 +75,7 @@
 #define RK3568_CSIDPHY_CLK_CALIB_EN		0x168
 
 #define CSIDPHY_LANE_CLK_3_PHASE		0x38
+#define CSIDPHY_LANE_CLK1_PHASE			0xcc
 #define CSIDPHY_CLK_PHASE_MASK			GENMASK(6, 4)
 #define CSIDPHY_CLK_PHASE_DEFAULT		3
 
@@ -89,6 +95,14 @@ enum dphy_reg_id {
 	GRF_DPHY_CSIPHY_FORCERXMODE,
 	GRF_DPHY_CSIPHY_CLKLANE_EN,
 	GRF_DPHY_CSIPHY_DATALANE_EN,
+	/* rk3568 split mode: lanes 2-3 with their own clock lane */
+	GRF_DPHY_CSIPHY_DATALANE_EN0,
+	GRF_DPHY_CSIPHY_DATALANE_EN1,
+	GRF_DPHY_CSIPHY_CLKLANE1_EN,
+	GRF_DPHY_CSIPHY_LANE_SEL,
+	GRF_DPHY_CIF_CSIPHY_SEL,
+	GRF_DPHY_ISP_CSIPHY_SEL,
+	GRF_DPHY_REG_MAX,
 };
 
 struct dphy_reg {
@@ -101,29 +115,35 @@ struct dphy_reg {
 #define PHY_REG(_offset, _width, _shift) \
 	{ .offset = _offset, .mask = BIT(_width) - 1, .shift = _shift, .valid = 1, }
 
-static const struct dphy_reg rk1808_grf_dphy_regs[] = {
+static const struct dphy_reg rk1808_grf_dphy_regs[GRF_DPHY_REG_MAX] = {
 	[GRF_DPHY_CSIPHY_FORCERXMODE] = PHY_REG(RK1808_GRF_PD_VI_CON_OFFSET, 4, 0),
 	[GRF_DPHY_CSIPHY_CLKLANE_EN] = PHY_REG(RK1808_GRF_PD_VI_CON_OFFSET, 1, 8),
 	[GRF_DPHY_CSIPHY_DATALANE_EN] = PHY_REG(RK1808_GRF_PD_VI_CON_OFFSET, 4, 4),
 };
 
-static const struct dphy_reg rk3326_grf_dphy_regs[] = {
+static const struct dphy_reg rk3326_grf_dphy_regs[GRF_DPHY_REG_MAX] = {
 	[GRF_DPHY_CSIPHY_FORCERXMODE] = PHY_REG(RK3326_GRF_PD_VI_CON_OFFSET, 4, 0),
 	[GRF_DPHY_CSIPHY_CLKLANE_EN] = PHY_REG(RK3326_GRF_PD_VI_CON_OFFSET, 1, 8),
 	[GRF_DPHY_CSIPHY_DATALANE_EN] = PHY_REG(RK3326_GRF_PD_VI_CON_OFFSET, 4, 4),
 };
 
-static const struct dphy_reg rk3368_grf_dphy_regs[] = {
+static const struct dphy_reg rk3368_grf_dphy_regs[GRF_DPHY_REG_MAX] = {
 	[GRF_DPHY_CSIPHY_FORCERXMODE] = PHY_REG(RK3368_GRF_SOC_CON6_OFFSET, 4, 8),
 };
 
-static const struct dphy_reg rk3568_grf_dphy_regs[] = {
+static const struct dphy_reg rk3568_grf_dphy_regs[GRF_DPHY_REG_MAX] = {
 	[GRF_DPHY_CSIPHY_FORCERXMODE] = PHY_REG(RK3568_GRF_VI_CON0, 4, 0),
 	[GRF_DPHY_CSIPHY_DATALANE_EN] = PHY_REG(RK3568_GRF_VI_CON0, 4, 4),
 	[GRF_DPHY_CSIPHY_CLKLANE_EN] = PHY_REG(RK3568_GRF_VI_CON0, 1, 8),
+	[GRF_DPHY_CSIPHY_DATALANE_EN0] = PHY_REG(RK3568_GRF_VI_CON0, 2, 4),
+	[GRF_DPHY_CSIPHY_DATALANE_EN1] = PHY_REG(RK3568_GRF_VI_CON0, 2, 6),
+	[GRF_DPHY_CSIPHY_CLKLANE1_EN] = PHY_REG(RK3568_GRF_VI_CON0, 1, 10),
+	[GRF_DPHY_CSIPHY_LANE_SEL] = PHY_REG(RK3568_GRF_VI_CON1, 1, 7),
+	[GRF_DPHY_CIF_CSIPHY_SEL] = PHY_REG(RK3568_GRF_VI_CON1, 1, 11),
+	[GRF_DPHY_ISP_CSIPHY_SEL] = PHY_REG(RK3568_GRF_VI_CON1, 1, 12),
 };
 
-static const struct dphy_reg rk3588_grf_dphy_regs[] = {
+static const struct dphy_reg rk3588_grf_dphy_regs[GRF_DPHY_REG_MAX] = {
 	[GRF_DPHY_CSIPHY_FORCERXMODE] = PHY_REG(RK3588_CSIDPHY_GRF_CON0, 4, 0),
 	[GRF_DPHY_CSIPHY_DATALANE_EN] = PHY_REG(RK3588_CSIDPHY_GRF_CON0, 4, 4),
 	[GRF_DPHY_CSIPHY_CLKLANE_EN] = PHY_REG(RK3588_CSIDPHY_GRF_CON0, 1, 8),
@@ -143,6 +163,7 @@ struct dphy_drv_data {
 	const struct dphy_reg *grf_regs;
 	const char *const *resets;
 	unsigned int resets_num;
+	bool has_split_mode;
 };
 
 struct rockchip_inno_csidphy {
@@ -156,6 +177,7 @@ struct rockchip_inno_csidphy {
 	struct phy_configure_opts_mipi_dphy config;
 	u8 hsfreq;
 	int clk_phase;
+	bool split_lanes_2_3;
 };
 
 static inline void write_grf_reg(struct rockchip_inno_csidphy *priv,
@@ -229,6 +251,9 @@ static int rockchip_inno_csidphy_configure(struct phy *phy,
 	if (ret)
 		return ret;
 
+	if (priv->split_lanes_2_3 && config->lanes > 2)
+		return -EINVAL;
+
 	data_rate_mbps = HZ_TO_MHZ(config->hs_clk_rate);
 
 	dev_dbg(priv->dev, "lanes %d - data_rate_mbps %llu\n",
@@ -247,6 +272,75 @@ static int rockchip_inno_csidphy_configure(struct phy *phy,
 	return 0;
 }
 
+/*
+ * rk3568 split mode, second half: data lanes 2-3 with clock lane 1, routed
+ * to the CSI-2 host (CIF path); lanes 0-1 are left to the ISP path. Same
+ * steps as Rockchip's BSP driver (phy-rockchip-csi2-dphy-hw.c, dphy2).
+ */
+static int rockchip_inno_csidphy_power_on_split(struct rockchip_inno_csidphy *priv)
+{
+	const struct dphy_drv_data *drv_data = priv->drv_data;
+	u64 data_rate_mbps = HZ_TO_MHZ(priv->config.hs_clk_rate);
+	u8 lanes = GENMASK(priv->config.lanes - 1, 0);
+	u32 val;
+	int i;
+
+	/* reset the digital part, dual (split) mode */
+	writel(CSIDPHY_CTRL_DIG_RST_UNDEFINED | CSIDPHY_CTRL_DIG_RST_DUAL_MODE,
+	       priv->phy_base + CSIDPHY_CTRL_DIG_RST);
+	writel(CSIDPHY_CTRL_DIG_RST_UNDEFINED | CSIDPHY_CTRL_DIG_RST_DUAL_MODE |
+	       CSIDPHY_CTRL_DIG_RST_RESET,
+	       priv->phy_base + CSIDPHY_CTRL_DIG_RST);
+
+	/* data lanes 2-3 and the clock lane */
+	val = FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_SPLIT_MASK, lanes) |
+	      FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_CK, 1) |
+	      FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_UNDEFINED, 1);
+	writel(val, priv->phy_base + CSIDPHY_CTRL_LANE_ENABLE);
+
+	write_grf_reg(priv, GRF_DPHY_CSIPHY_DATALANE_EN1, lanes);
+	write_grf_reg(priv, GRF_DPHY_CSIPHY_CLKLANE1_EN, 0x1);
+	/*
+	 * Also enable the first half's clock lane and data lanes 0-1 in the
+	 * GRF. Seen on the Teclast P25T: with only the second half enabled
+	 * the VICAP behind the CSI-2 host wrote past its buffers (IOMMU page
+	 * fault); with these bits on as well, as the full mode leaves them,
+	 * frames are clean. The D-PHY's own lane 0-1 enables are not needed.
+	 */
+	write_grf_reg(priv, GRF_DPHY_CSIPHY_CLKLANE_EN, 0x1);
+	write_grf_reg(priv, GRF_DPHY_CSIPHY_DATALANE_EN0, 0x3);
+	write_grf_reg(priv, GRF_DPHY_CSIPHY_LANE_SEL, 0x1);
+	write_grf_reg(priv, GRF_DPHY_CIF_CSIPHY_SEL, 0x1);
+	write_grf_reg(priv, GRF_DPHY_ISP_CSIPHY_SEL, 0x0);
+
+	/* not into receive mode/wait stopstate */
+	write_grf_reg(priv, GRF_DPHY_CSIPHY_FORCERXMODE, 0x0);
+
+	if (data_rate_mbps > 1500 && drv_data->calib_offset >= 0) {
+		writel(CSIDPHY_CALIB_EN, priv->phy_base +
+		       drv_data->calib_offset + CSIDPHY_CLK1_CALIB_EN);
+		for (i = 0; i < priv->config.lanes; i++)
+			writel(CSIDPHY_CALIB_EN, priv->phy_base +
+			       drv_data->calib_offset +
+			       CSIDPHY_LANE_CALIB_EN(2 + i));
+	}
+
+	if (priv->clk_phase >= 0) {
+		val = readl(priv->phy_base + CSIDPHY_LANE_CLK1_PHASE);
+		val &= ~CSIDPHY_CLK_PHASE_MASK;
+		val |= FIELD_PREP(CSIDPHY_CLK_PHASE_MASK, priv->clk_phase);
+		writel(val, priv->phy_base + CSIDPHY_LANE_CLK1_PHASE);
+	}
+
+	rockchip_inno_csidphy_ths_settle(priv, priv->hsfreq,
+					 CSIDPHY_CLK1_THS_SETTLE);
+	for (i = 0; i < priv->config.lanes; i++)
+		rockchip_inno_csidphy_ths_settle(priv, priv->hsfreq,
+						 CSIDPHY_LANE_THS_SETTLE(2 + i));
+
+	return 0;
+}
+
 static int rockchip_inno_csidphy_power_on(struct phy *phy)
 {
 	struct rockchip_inno_csidphy *priv = phy_get_drvdata(phy);
@@ -271,6 +365,9 @@ static int rockchip_inno_csidphy_power_on(struct phy *phy)
 		       CSIDPHY_CTRL_PWRCTL_SYNCRST,
 		       priv->phy_base + drv_data->pwrctl_offset);
 
+	if (priv->split_lanes_2_3)
+		return rockchip_inno_csidphy_power_on_split(priv);
+
 	/* set data lane num and enable clock lane */
 	val = FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_MASK, GENMASK(priv->config.lanes - 1, 0)) |
 	      FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_CK, 1) |
@@ -319,6 +416,9 @@ static int rockchip_inno_csidphy_power_on(struct phy *phy)
 	write_grf_reg(priv, GRF_DPHY_CSIPHY_CLKLANE_EN, 0x1);
 	write_grf_reg(priv, GRF_DPHY_CSIPHY_DATALANE_EN,
 		      GENMASK(priv->config.lanes - 1, 0));
+	/* full mode: lanes 0-3 to the CSI-2 host (rk3568 reset defaults) */
+	write_grf_reg(priv, GRF_DPHY_CSIPHY_LANE_SEL, 0x0);
+	write_grf_reg(priv, GRF_DPHY_CIF_CSIPHY_SEL, 0x0);
 
 	return 0;
 }
@@ -413,6 +513,7 @@ static const struct dphy_drv_data rk3568_mipidphy_drv_data = {
 	.grf_regs = rk3568_grf_dphy_regs,
 	.resets = rk3368_reset_names,
 	.resets_num = ARRAY_SIZE(rk3368_reset_names),
+	.has_split_mode = true,
 };
 
 static const struct dphy_drv_data rk3588_mipidphy_drv_data = {
@@ -489,6 +590,13 @@ static int rockchip_inno_csidphy_probe(struct platform_device *pdev)
 		priv->clk_phase = phase;
 	}
 
+	if (device_property_read_bool(dev, "rockchip,split-lanes-2-3")) {
+		if (priv->drv_data->has_split_mode)
+			priv->split_lanes_2_3 = true;
+		else
+			dev_warn(dev, "split mode not supported, ignored\n");
+	}
+
 	priv->grf = syscon_regmap_lookup_by_phandle(dev->of_node,
 						    "rockchip,grf");
 	if (IS_ERR(priv->grf)) {
-- 
